# Cloudflare static-asset response headers.
# NOTE: matching rules are CUMULATIVE — a request matching both /* and /admin/*
# inherits headers from BOTH, and a header set twice is joined (two CSPs =
# enforced as their intersection). So /admin/* must DETACH the inherited /* CSP
# with `! Content-Security-Policy` before setting its own permissive policy.
# Hashes below are exact-byte sha256 of inline scripts — verified by
# scripts/check-csp-hashes.mjs after every build. Do NOT trim before hashing.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://platform.linkedin.com https://static.cloudflareinsights.com 'sha256-Pqppwr2CfRmjC5H8h4BNEJ7qTwPb/+0XTOQd59+RSWs=' 'sha256-rb1E3mybuzV90LQYB65UPGlF4lHBxWIcMVdjvxdql7w=' 'sha256-f7CtDJFBszqGT/BjhhTFBoCLMhT+CF8wOSh/9CO0TE8='; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://platform.linkedin.com https://cloudflareinsights.com; frame-src https://platform.linkedin.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Decap CMS — loads from unpkg, talks to the GitHub API, needs unsafe-inline/eval.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; font-src 'self' data: https://unpkg.com; connect-src 'self' https://api.github.com https://unpkg.com; frame-src 'self'; frame-ancestors 'none'; base-uri 'self';
