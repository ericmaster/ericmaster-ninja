# Handle line endings automatically for files detected as text
# and leave binary files alone.
* text=auto

# Force text files to always use LF on checkout
# and be stored as LF in the index.
*.astro text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
