---
interface Props {
  projectsCount?: number;
  cheatsheetsCount?: number;
  lang?: "en" | "es";
}

const { projectsCount = 4, cheatsheetsCount = 2, lang = "en" } = Astro.props;

const labels = {
  en: {
    projects: "Projects",
    cheatsheets: "Cheatsheets",
    ariaLabel: "Resource categories navigation",
  },
  es: {
    projects: "Proyectos",
    cheatsheets: "Hojas de Trucos",
    ariaLabel: "Navegación de categorías de recursos",
  },
}[lang];
---

<nav
  class="sticky top-20 z-30 my-8 mx-auto w-fit max-w-[95vw] px-2 py-1.5 rounded-full bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border border-slate-200/90 dark:border-slate-800 shadow-lg flex items-center justify-center gap-1.5 transition-all duration-300"
  aria-label={labels.ariaLabel}
  x-data="resourcesNav"
>
  <a
    href="#projects"
    data-section-id="projects"
    @click.prevent="scrollToSection"
    :class="active === 'projects' ? 'bg-indigo-600 text-white shadow-sm font-semibold' : 'text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 font-medium'"
    class="flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 no-underline cursor-pointer"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
    </svg>
    <span>{labels.projects}</span>
    {projectsCount > 0 && (
      <span
        :class="active === 'projects' ? 'bg-white/25 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300'"
        class="text-[11px] px-1.5 py-0.5 rounded-full font-mono"
      >
        {projectsCount}
      </span>
    )}
  </a>

  <a
    href="#cheatsheets"
    data-section-id="cheatsheets"
    @click.prevent="scrollToSection"
    :class="active === 'cheatsheets' ? 'bg-indigo-600 text-white shadow-sm font-semibold' : 'text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 font-medium'"
    class="flex items-center gap-2 px-4 py-2 rounded-full text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 no-underline cursor-pointer"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <span>{labels.cheatsheets}</span>
    {cheatsheetsCount > 0 && (
      <span
        :class="active === 'cheatsheets' ? 'bg-white/25 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300'"
        class="text-[11px] px-1.5 py-0.5 rounded-full font-mono"
      >
        {cheatsheetsCount}
      </span>
    )}
  </a>
</nav>
