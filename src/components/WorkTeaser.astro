---
// src/components/WorkTeaser.astro
---

<section class="w-full my-12">
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800/50 dark:to-slate-900/50 border border-slate-200 dark:border-slate-700/50 p-8 shadow-lg group">
    <!-- Animated background element -->
    <div class="absolute -right-12 -top-12 w-48 h-48 bg-indigo-500/5 rounded-full blur-3xl group-hover:bg-indigo-500/10 transition-colors duration-500"></div>
    
    <div class="relative flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex-1 text-center md:text-left">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-3">
          Professional <span class="text-indigo-600 dark:text-indigo-400">AI Solutions</span>
        </h2>
        <p class="text-slate-600 dark:text-slate-300 max-w-xl">
          From specialized Generative UI websites to expert AI auditing and SME consulting. Let's build the future of your business together.
        </p>
      </div>
      
      <div class="flex-shrink-0">
        <a
          href="/work"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition-all duration-300 shadow-md hover:shadow-indigo-500/25 transform hover:-translate-y-0.5"
        >
          View My Portfolio
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
