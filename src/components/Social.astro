---
import { Icon } from "astro-icon/components";

interface Props {
  platform: string;
  username?: string;
  href?: string;
  icon?: string;
  class?: string;
}

const { platform, username, href, icon, class: className } = Astro.props;

type PlatformConfig = {
  url: string;
  defaultIcon: string;
  colorClass: string;
};

const PLATFORM_CONFIG: Record<string, PlatformConfig> = {
  twitter: {
    url: `https://x.com/${username}`,
    defaultIcon: "simple-icons:x",
    colorClass: "text-black dark:text-white",
  },
  x: {
    url: `https://x.com/${username}`,
    defaultIcon: "simple-icons:x",
    colorClass: "text-black dark:text-white",
  },
  linkedin: {
    url: `https://www.linkedin.com/in/${username}/`,
    defaultIcon: "mdi:linkedin",
    colorClass: "text-[#0077b5]",
  },
  whatsapp: {
    url: `https://wa.me/${username}`,
    defaultIcon: "mdi:whatsapp",
    colorClass: "text-[#25D366]",
  },
  github: {
    url: `https://github.com/${username}`,
    defaultIcon: "simple-icons:github",
    colorClass: "text-[#181717] dark:text-white",
  },
  youtube: {
    url: `https://www.youtube.com/${username}`,
    defaultIcon: "simple-icons:youtube",
    colorClass: "text-[#FF0000]",
  },
};

const config = PLATFORM_CONFIG[platform.toLowerCase()] || {
  url: `https://www.${platform}.com/${username}`,
  defaultIcon: `mdi:${platform}`,
  colorClass: "",
};

const computedHref = href || config.url;
const computedIcon = icon || config.defaultIcon;
// Quiet, monochrome footer icons by default — accent only on hover (keeps the
// slate-and-amber palette calm). Pass an explicit `class` prop to opt back into
// brand colors (e.g. config.colorClass) where wanted.
const computedColorClass =
  className ||
  "text-slate-400 dark:text-slate-500 hover:text-indigo-600 dark:hover:text-amber-400 transition-colors";
---

<a
  href={computedHref}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center gap-2"
  aria-label={platform}
>
  <Icon name={computedIcon} class={`w-8 h-8 ${computedColorClass}`.trim()} />
</a>

<style>
  a {
    padding: 0.5rem 1rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  a:hover {
    opacity: 0.8;
  }
</style>
