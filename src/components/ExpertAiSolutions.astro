---
// src/components/ExpertAiSolutions.astro
const waNumber = "593983337611";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Hi Eric, I would like to book a professional AI consultation."
)}`;

const services = [
  {
    title: "AI Hallucination & Fact-Checking Auditor",
    description:
      "Human-in-the-loop certification for technical, medical, and legal AI outputs to ensure absolute reliability.",
    icon: "magnifying-glass-chart", // We'll use heroicons SVG directly or simple standard
  },
  {
    title: "Technical Interviewer",
    subtitle: "Smoke Filter",
    description:
      "Expert screening of AI and Engineering candidates to distinguish between real logic and LLM-assisted mimicry.",
    icon: "user-group",
  },
  {
    title: "Turnkey AI for SMEs",
    description:
      "End-to-end automation and custom bots for local business workflows. (Demonstrated by the live demo on this page).",
    icon: "cog-6-tooth",
  },
  {
    title: "AI Concierge & Data Privacy",
    description:
      "Specialized consulting on secure AI adoption, private deployments, and personal data hardening for high-level professionals.",
    icon: "shield-check",
  },
];
---

<section class="w-full my-16 font-sans">
  <div class="text-center mb-12">
    <h2
      class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4"
    >
      Expert AI Solutions
    </h2>
    <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
      Mission-critical AI implementations requiring Human Intelligence + AI
      Oversight.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
    {
      services.map((service) => (
        <div class="group bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-xl border border-slate-100 dark:border-slate-700 hover:shadow-2xl hover:border-blue-500/50 transition-all duration-300 flex flex-col items-start relative overflow-hidden">
          <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            {service.icon === "magnifying-glass-chart" && (
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                />
              </svg>
            )}
            {service.icon === "user-group" && (
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                />
              </svg>
            )}
            {service.icon === "cog-6-tooth" && (
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            )}
            {service.icon === "shield-check" && (
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                />
              </svg>
            )}
          </div>

          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 leading-tight">
            {service.title}
            {service.subtitle && (
              <span class="block text-sm font-semibold text-blue-600 dark:text-blue-400 mt-1">
                {service.subtitle}
              </span>
            )}
          </h3>

          <p class="text-slate-600 dark:text-slate-300 text-sm mb-8 flex-1">
            {service.description}
          </p>

          <a
            href={waLink}
            target="_blank"
            class="mt-auto w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-sm hover:shadow-md rounded-lg transition-all focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-800"
          >
            Book Consultation
            <svg
              class="w-4 h-4 ml-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      ))
    }
  </div>

  <!-- Sticky Mobile Contact Button placeholder info -->
  <div class="md:hidden fixed bottom-6 left-6 z-40">
    <a
      href={waLink}
      target="_blank"
      class="w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-2xl flex items-center justify-center transition-transform hover:scale-105"
      aria-label="WhatsApp Contact"
    >
      <svg
        class="w-7 h-7"
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
