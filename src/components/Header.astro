---
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  id="site-header"
  x-data="mobileNav"
  class="flex -mx-4 px-4 items-center relative sticky top-0 z-20 bg-slate-50/80 backdrop-blur-sm border-b border-slate-200/60 dark:border-slate-800/60 transition-all duration-300"
>
  <div class="mr-4 hover:opacity-80 transition-opacity">
    <a href={getLocalePath(lang, "/")} aria-label={t("nav.home")}>
      <Logo />
    </a>
  </div>
  <Hamburger
    aria-expanded="false"
    aria-controls="site-navigation"
    @click="toggleNav"
    :aria-expanded="ariaExpanded"
    :open="navOpen"
  />
  <Navigation
    id="site-navigation"
    :class="navClass"
    :open="navOpen"
  />
  <div class="ml-auto">
    <ThemeIcon />
  </div>
</header>
<script is:inline>
  const header = document.getElementById("site-header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      header.classList.add("header-scrolled");
    } else {
      header.classList.remove("header-scrolled");
    }
  });
</script>

