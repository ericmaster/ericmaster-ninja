---
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav
  {...Astro.props}
  class="nav-links absolute md:block hidden w-full md:w-auto top-full left-0 w-full bg-white shadow-md z-50 md:static md:w-auto md:!bg-transparent md:shadow-none md:block transition-all"
>
  <a href={getLocalePath(lang, "/")}>{t("nav.home")}</a>
  <a href={getLocalePath(lang, "/about/")}>{t("nav.about")}</a>
  <a href={getLocalePath(lang, "/blog/")}>{t("nav.blog")}</a>
  <a href={getLocalePath(lang, "/resources/")}>{t("nav.resources")}</a>
  <a href={getLocalePath(lang, "/work/")}>{t("nav.work")}</a>
  <a href={getLocalePath(lang, "/resume/")}>{t("nav.resume")}</a>
  <!-- <a href={getLocalePath(lang, "/tags/")}>Tags</a> -->
</nav>
