---
import { formatLocalizedDate } from "../lib/dateUtils";

export interface Props {
  post: {
    title: string;
    pubDate?: string;
    description?: string;
    url: string;
    image?: {
      url: string;
      alt?: string;
    };
  };
}
const { post } = Astro.props;
---

<li class="post-card">
  <a
    href={post.url}
    class="flex flex-col md:flex-row items-center md:items-start gap-6 p-6 rounded-lg"
  >
    <div class="w-full lg:min-w-[300px] min-w-[200px]">
      <img
        src={post.image?.url}
        alt={post.title}
        class="w-full"
        loading="lazy"
        decoding="async"
        width="300"
        height="200"
      />
      {
        post.pubDate && (
          <>
            <small>{formatLocalizedDate(post.pubDate)}</small>
            <br />
          </>
        )
      }
    </div>

    <div class="flex flex-col">
      <h3>
        {post.title}
      </h3>
      <span>{post.description}</span>
    </div>
  </a>
</li>
