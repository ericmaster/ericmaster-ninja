---
import { formatLocalizedDate } from "../lib/dateUtils";

export interface Props {
  post: {
    title: string;
    pubDate?: string;
    description?: string;
    url: string;
    image?: {
        url: string;
        alt?: string;
    };
  };
}
const { post } = Astro.props;
---

<li class="post-card mb-4">
  <a
    href={post.url}
    class="flex flex-col md:flex-row items-center md:items-start gap-6 mb-8 p-6 rounded-lg"
  >
    <img
      src={post.image?.url}
      alt={post.title}
      class=""
      loading="lazy"
      decoding="async"
      width="300"
      height="200"
    />
    <div class="flex flex-col">
      <h3>
        {post.title}
      </h3>
      {post.pubDate && (
        <>
          <small>Published: {formatLocalizedDate(post.pubDate)}</small>
          <br />
        </>
      )}
      <span>{post.description}</span>
    </div>
  </a>
</li>
