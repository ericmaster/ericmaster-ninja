---
import PostTeaser from "./PostTeaser.astro";
import { getPosts } from "../lib/blogUtils";
const latestPosts = await getPosts(5);
---

<section {...Astro.props}>
  <h2 class="pl-6">Latest Posts</h2>
  <ul>
    {
      latestPosts.length === 0 ? (
        <li>No posts yet.</li>
      ) : (
        latestPosts.map((post) => (
          <>
            <PostTeaser post={post} />
            <hr />
          </>
        ))
      )
    }
  </ul>
</section>
