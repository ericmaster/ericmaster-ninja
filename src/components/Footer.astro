---
import Social from "./Social.astro";
import { SOCIAL_LINKS } from "../lib/siteConfig";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
---

<footer class="flex flex-col items-center gap-4 mt-8">
  <div class="flex gap-2 items-center">
    {SOCIAL_LINKS.map((link) => (
      <Social platform={link.platform} username={link.username} />
    ))}
  </div>
  <div class="text-sm text-gray-500 dark:text-gray-400 mt-4 mb-8">
    &copy; {currentYear} Eric Aguayo. {t("footer.rights")}
  </div>
</footer>
