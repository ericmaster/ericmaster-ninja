---
import Social from "./Social.astro";
import { SOCIAL_LINKS } from "../lib/siteConfig";

const currentYear = new Date().getFullYear();
---

<footer class="flex flex-col items-center gap-4 mt-8">
  <div class="flex gap-2 items-center">
    {SOCIAL_LINKS.map((link) => (
      <Social platform={link.platform} username={link.username} />
    ))}
  </div>
  <div class="text-sm text-gray-500 dark:text-gray-400 mt-4 mb-8">
    &copy; {currentYear} Eric Aguayo. All rights reserved.
  </div>
</footer>
