---
/**
 * ResumeNav — Sticky sidebar navigation for resume sections.
 * Uses Alpine.js IntersectionObserver to highlight the active section.
 * Hidden on print and below lg breakpoint.
 */

interface Section {
  id: string;
  label: string;
}

const sections: Section[] = [
  { id: "summary-heading", label: "Summary" },
  { id: "experience-heading", label: "Experience" },
  { id: "skills-heading", label: "Skills" },
  { id: "projects-heading", label: "Projects" },
  { id: "education-heading", label: "Education" },
  { id: "certifications-heading", label: "Certifications" },
  { id: "languages-heading", label: "Languages" },
  { id: "leadership-heading", label: "Leadership" },
];
---

<nav
  class="resume-nav no-print"
  aria-label="Resume section navigation"
  x-data="resumeNav"
>
  <ul class="resume-nav-list">
    {sections.map((s) => (
      <li>
        <a
          href={`#${s.id}`}
          class="resume-nav-link"
          data-section-id={s.id}
          x-bind:class="navItemClass"
          x-on:click.prevent="scrollToSection"
        >
          {s.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
