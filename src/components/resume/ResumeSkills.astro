---
interface ResumeSkill {
  name: string;
  description?: string;
  level?: number;
  keywords?: string[];
}

interface Props {
  items: ResumeSkill[];
  id?: string;
}

const { items, id = "skills-heading" }: Props = Astro.props;
---
{items.length > 0 && (
  <section class="resume-section" aria-labelledby={id}>
    <h2 id={id} class="section-title">Skills</h2>
    <div class="section-content skills-grid">
      {items.map((skill) => (
        <div class="skill-item">
          <div class="skill-header">
            <span class="skill-name">{skill.name}</span>
            <span class="skill-desc">{skill.description}</span>
          </div>
          {skill.level && (
            <div class="skill-bar" aria-label={`Level ${skill.level} out of 5`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span class={`skill-pip ${skill.level && n <= skill.level ? 'filled' : ''}`}></span>
              ))}
            </div>
          )}
          <!-- ATS: keywords listed explicitly as text -->
          {skill.keywords && skill.keywords.length > 0 && (
            <ul class="skill-keywords">
              {skill.keywords.map((kw) => (<li class="skill-keyword">{kw}</li>))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
)}
