---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-title">Skills</h2>
    <div class="section-content skills-grid">
      {items.map((skill: any) => (
        <div class="skill-item">
          <div class="skill-header">
            <span class="skill-name">{skill.name}</span>
            <span class="skill-desc">{skill.description}</span>
          </div>
          {skill.level && (
            <div class="skill-bar" aria-label={`Level ${skill.level} out of 5`}>
              {[1,2,3,4,5].map(n => (
                <span class={`skill-pip ${n <= skill.level ? 'filled' : ''}`} />
              ))}
            </div>
          )}
          {skill.keywords && skill.keywords.length > 0 && (
            <!-- ATS: keywords listed explicitly as text -->
            <ul class="skill-keywords">
              {skill.keywords.map((kw: string) => <li class="skill-keyword">{kw}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
)}
