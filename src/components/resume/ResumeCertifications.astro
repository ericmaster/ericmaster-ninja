---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="certifications-heading">
    <h2 id="certifications-heading" class="section-title">Certifications</h2>
    <div class="section-content">
      {items.map((cert: any) => (
        <article class="resume-item">
          <div class="item-header">
            <div class="item-primary">
              <h3 class="item-title">{cert.name}</h3>
              <span class="item-subtitle">
                {cert.url
                  ? <a href={cert.url} target="_blank" rel="noopener noreferrer">{cert.issuer}</a>
                  : cert.issuer}
              </span>
            </div>
            {cert.date && <time class="item-date">{cert.date}</time>}
          </div>
        </article>
      ))}
    </div>
  </section>
)}
