---
interface Education {
  institution: string;
  url?: string;
  area: string;
  studyType: string;
  date: string;
  score?: string;
}

interface Props {
  items: Education[];
}

const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="education-heading">
    <h2 id="education-heading" class="section-title">Education</h2>
    <div class="section-content">
      {items.map((edu: any) => (
        <article class="resume-item">
          <div class="item-header">
            <div class="item-primary">
              <h3 class="item-title">{edu.studyType} in {edu.area}</h3>
              <span class="item-subtitle">
                {edu.url
                  ? <a href={edu.url} target="_blank" rel="noopener noreferrer">{edu.institution}</a>
                  : edu.institution}
              </span>
            </div>
            <div class="item-date-group">
              <time class="item-date">{edu.date}</time>
              {edu.score && <span class="item-score">{edu.score}</span>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
