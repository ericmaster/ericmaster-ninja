---
export interface ExperienceItem {
  company: string;
  position: string;
  location?: string;
  date: string;
  summary?: string;
  url?: string;
}

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props as Props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title">Work Experience</h2>
    <div class="section-content">
      {items.map((job: ExperienceItem) => (
        <article class="resume-item">
          <div class="item-header">
            <div class="item-primary">
              <!-- ATS: Use strong for job title, separating company and title -->
              <h3 class="item-title">{job.position}</h3>
              <span class="item-subtitle">
                {job.url
                  ? <a href={job.url} target="_blank" rel="noopener noreferrer">{job.company}</a>
                  : job.company}
                {job.location && <span class="item-location"> · {job.location}</span>}
              </span>
            </div>
            <time class="item-date">{job.date}</time>
          </div>
          {job.summary && <div class="item-summary prose" set:html={job.summary} />}
        </article>
      ))}
    </div>
  </section>
)}
