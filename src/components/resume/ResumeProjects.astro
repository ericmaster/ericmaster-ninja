---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="section-title">Projects</h2>
    <div class="section-content">
      {items.map((proj: any) => (
        <article class="resume-item">
          <div class="item-header">
            <div class="item-primary">
              <h3 class="item-title">
                {proj.url
                  ? <a href={proj.url} target="_blank" rel="noopener noreferrer">{proj.name}</a>
                  : proj.name}
              </h3>
              {proj.description && <p class="item-subtitle">{proj.description}</p>}
            </div>
            {proj.date && <time class="item-date">{proj.date}</time>}
          </div>
          {proj.keywords && proj.keywords.length > 0 && (
            <ul class="skill-keywords">
              {proj.keywords.map((kw: string) => <li class="skill-keyword">{kw}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>
)}
