---
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

interface Props {
  summary?: string;
}

const { summary } = Astro.props;

// Parse the markdown string into HTML
const parsedSummary = summary ? sanitizeHtml(marked.parse(summary) as string) : '';
---
{summary && (
  <section class="resume-section" aria-labelledby="summary-heading">
    <h2 id="summary-heading" class="section-title">Professional Summary</h2>
    <div class="section-content prose" set:html={parsedSummary} />
  </section>
)}
