---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="leadership-heading">
    <h2 id="leadership-heading" class="section-title">Leadership & Community</h2>
    <div class="section-content">
      <ul class="leadership-list">
        {items.map((item: any) => (
          <li class="leadership-item">
            <div class="item-header">
              <div class="item-primary">
                <span class="item-title">
                  {item.url
                    ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
                    : item.name}
                </span>
                <span class="item-subtitle">
                  {item.description}
                  {item.location && ` · ${item.location}`}
                </span>
              </div>
              {item.date && <time class="item-date">{item.date}</time>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
