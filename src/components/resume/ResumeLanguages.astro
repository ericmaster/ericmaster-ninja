---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <section class="resume-section" aria-labelledby="languages-heading">
    <h2 id="languages-heading" class="section-title">Languages</h2>
    <div class="section-content">
      <ul class="lang-list">
        {items.map((lang: any) => (
          <li class="lang-item">
            <span class="lang-name">{lang.name}</span>
            <span class="lang-desc">{lang.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
