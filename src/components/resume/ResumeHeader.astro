---
interface Profile {
  network: string;
  url: string;
}

interface Basics {
  name: string;
  headline: string;
  image?: string;
  email?: string;
  phone?: string;
  location?: string;
  website?: string;
}

interface Props {
  basics: Basics;
  profiles?: Profile[];
}

const { basics, profiles } = Astro.props;
---
<header class="resume-header no-print">
  <div class="resume-header-inner">
    {basics.image && (
      <div class="resume-avatar-container">
        <img src={basics.image} alt={basics.name} class="resume-avatar" />
      </div>
    )}
    <div class="resume-header-info">
      <!-- ATS-friendly: name as h1, contact on separate lines -->
      <div class="header-top">
        <h1 class="resume-name">{basics.name}</h1>
        <p class="resume-headline">{basics.headline}</p>
      </div>
      <address class="resume-contact">
        {basics.email && (
          <span class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${basics.email}`}>{basics.email}</a>
          </span>
        )}
        {basics.phone && (
          <span class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 2h3a2 2 0 0 1 2 1.72c.127.960.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.850.573 2.81.7A2 2 0 0 1 21 17z"/></svg>
            <a href={`tel:${basics.phone}`}>{basics.phone}</a>
          </span>
        )}
        {basics.location && (
          <span class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{basics.location}</span>
          </span>
        )}
        {basics.website && (
          <span class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            <a href={basics.website} target="_blank" rel="noopener noreferrer">{basics.website.replace(/^https?:\/\//, '')}</a>
          </span>
        )}
        {profiles && profiles.map((p: any) => (
          <span class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <a href={p.url} target="_blank" rel="noopener noreferrer">{p.network}</a>
          </span>
        ))}
      </address>
    </div>
  </div>
</header>
