---
const {
  locale = "en_US",
  size = "large",
  theme = "dark",
  type = "HORIZONTAL",
  vanity = "eric-aguayo",
  profileUrl = "https://ec.linkedin.com/in/eric-aguayo?trk=profile-badge",
  name = "Eric Aguayo",
  class: className = "flex justify-end",
  ...rest
} = Astro.props;

const profileLink = `<a class="badge-base__link LI-simple-link" href="${profileUrl}">${name}</a>`;

// Use a client-side snippet to set the initial theme before the script runs
---

<div class={className} {...rest}>
  <div
    id="linkedin-badge-container"
    class="badge-base LI-profile-badge"
    data-locale={locale}
    data-size={size}
    data-theme="dark" 
    data-type={type}
    data-vanity={vanity}
    data-version="v1"
  >
    <Fragment set:html={profileLink} />
  </div>
</div>

<script is:inline>
  let lastTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";

  function updateLinkedInBadge() {
    const container = document.getElementById("linkedin-badge-container");
    if (!container) return;

    const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
    
    // Only re-run if theme actually changed
    if (container.getAttribute("data-theme") === currentTheme && container.querySelector('iframe')) {
      return;
    }

    // Only re-run if theme actually changed or badge is missing
    const hasIframe = container.querySelector('iframe');
    if (container.getAttribute("data-theme") === currentTheme && hasIframe) {
      return;
    }

    container.setAttribute("data-theme", currentTheme);

    // Remove existing script tags
    document.querySelectorAll('script[src*="linkedin.com/badges/js/profile.js"]').forEach(s => s.remove());
    
    // Reset container to original state for re-injection
    const linkElement = container.querySelector('a.LI-simple-link');
    const href = linkElement ? linkElement.getAttribute('href') : 'https://ec.linkedin.com/in/eric-aguayo';
    const name = linkElement ? linkElement.textContent : 'Eric Aguayo';
    
    container.innerHTML = `<a class="badge-base__link LI-simple-link" href="${href}">${name}</a>`;

    const script = document.createElement("script");
    // Add cache-buster to force script execution
    script.src = `https://platform.linkedin.com/badges/js/profile.js?v=${Date.now()}`;
    script.async = true;
    script.defer = true;
    document.body.appendChild(script);
  }

  // Initial load
  if (document.readyState === 'complete') {
    updateLinkedInBadge();
  } else {
    window.addEventListener('load', updateLinkedInBadge);
  }

  // Debounced observer for theme changes
  let timeout;
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === "class") {
        const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
        if (currentTheme !== lastTheme) {
          clearTimeout(timeout);
          timeout = setTimeout(updateLinkedInBadge, 150);
        }
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });
</script>
