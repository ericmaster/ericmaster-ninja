---
const {
  locale = "en_US",
  size = "large",
  theme = "dark",
  type = "HORIZONTAL",
  vanity = "eric-aguayo",
  profileUrl = "https://ec.linkedin.com/in/eric-aguayo?trk=profile-badge",
  name = "Eric Aguayo",
  class: className = "flex justify-end",
  ...rest
} = Astro.props;
---

<div class={className} {...rest}>
  <!-- Dark theme badge - shown when .dark class is on html -->
  <div
    class="badge-base LI-profile-badge hidden dark:block"
    data-locale={locale}
    data-size={size}
    data-theme="dark"
    data-type={type}
    data-vanity={vanity}
    data-version="v1"
  >
    <a class="badge-base__link LI-simple-link" href={profileUrl}>{name}</a>
  </div>

  <!-- Light theme badge - shown by default, hidden when .dark class is on html -->
  <div
    class="badge-base LI-profile-badge block dark:hidden"
    data-locale={locale}
    data-size={size}
    data-theme="light"
    data-type={type}
    data-vanity={vanity}
    data-version="v1"
  >
    <a class="badge-base__link LI-simple-link" href={profileUrl}>{name}</a>
  </div>
</div>

<script src="https://platform.linkedin.com/badges/js/profile.js" async defer></script>
