---
// src/components/GenUiHighlight.astro
const waNumber = "593983337611";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Hi Eric, I'm interested in learning more about Generative UI Websites for my project."
)}`;
---

<section class="w-full my-12 font-sans">
  <div class="relative group overflow-hidden rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl transition-all duration-500 hover:border-indigo-500/50">
    <!-- Background Decoration -->
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-600/5 via-transparent to-violet-600/5 dark:from-indigo-600/10 dark:to-violet-600/10 opacity-50 group-hover:opacity-100 transition-opacity"></div>
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-full blur-3xl group-hover:bg-indigo-500/20 dark:group-hover:bg-indigo-500/30 transition-all duration-700"></div>
    <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-violet-500/10 dark:bg-violet-500/20 rounded-full blur-3xl group-hover:bg-violet-500/20 dark:group-hover:bg-violet-500/30 transition-all duration-700"></div>

    <div class="relative p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <!-- Content Side -->
      <div class="flex-1 text-center md:text-left">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider mb-6">
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
          </span>
          Featured Service
        </div>
        
        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white mb-4 tracking-tight leading-tight">
          Generative UI <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400">Websites</span>
        </h2>
        
        <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-xl leading-relaxed">
          The next evolution of the web. Interfaces that don't just sit there—they adapt, think, and respond to your users' intent in real-time. Powered by <a href="https://www.nimblersoft.com/" target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline decoration-indigo-500/30">Nimblersoft</a> orchestration.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href={waLink}
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-indigo-600 hover:bg-indigo-500 shadow-[0_0_20px_rgba(79,70,229,0.3)] dark:shadow-[0_0_20px_rgba(79,70,229,0.4)] hover:shadow-[0_0_30px_rgba(79,70,229,0.5)] rounded-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            Start Your Project
            <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          
          <a
            href="https://www.nimblersoft.com/"
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-bold text-slate-600 dark:text-slate-300 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl transition-all"
          >
            Explore Nimblersoft
          </a>
        </div>
      </div>

      <!-- Visual Side (Abstract GenUI representation) -->
      <div class="relative w-full max-w-[320px] aspect-square flex items-center justify-center">
        <div class="absolute inset-0 bg-indigo-500/5 dark:bg-indigo-500/10 rounded-3xl rotate-6 scale-95 animate-pulse"></div>
        <div class="absolute inset-0 bg-violet-500/5 dark:bg-violet-500/10 rounded-3xl -rotate-3 scale-95"></div>
        <div class="relative w-full h-full bg-slate-50/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-2xl border border-slate-200 dark:border-slate-700 p-6 flex flex-col justify-between shadow-2xl overflow-hidden">
          <!-- Mock UI Elements -->
          <div class="space-y-3">
            <div class="h-2 w-1/3 bg-slate-200 dark:bg-slate-700 rounded-full animate-pulse"></div>
            <div class="h-8 w-full bg-slate-200/50 dark:bg-slate-700/50 rounded-lg"></div>
            <div class="h-4 w-2/3 bg-slate-200/30 dark:bg-slate-700/30 rounded-full"></div>
          </div>
          
          <div class="flex gap-2">
            <div class="h-10 w-10 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg border border-indigo-500/20 dark:border-indigo-500/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
               <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div class="flex-1 h-10 bg-slate-200/20 dark:bg-slate-700/20 rounded-lg border border-slate-200/30 dark:border-slate-700/30"></div>
          </div>
          
          <div class="space-y-2">
             <div class="h-2 w-full bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
             <div class="h-2 w-4/5 bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
             <div class="h-2 w-1/2 bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
          </div>

          <!-- Glow -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-indigo-500/10 dark:bg-indigo-500/20 blur-2xl rounded-full"></div>
        </div>
      </div>
    </div>
  </div>
</section>
