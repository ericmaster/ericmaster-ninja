---
// src/components/GenUiHighlight.astro
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const waNumber = "593983337611";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Hi Eric, I'm interested in learning more about Generative UI Websites for my project."
)}`;
---

<section class="w-full my-12 font-sans">
  <div class="relative group overflow-hidden rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-colors duration-200 hover:border-indigo-500/50">
    <div class="relative p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <!-- Content Side -->
      <div class="flex-1 text-center md:text-left">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="inline-flex rounded-full h-2 w-2 bg-indigo-500 mr-2"></span>
          {t("genui.badge")}
        </div>

        <h2 class="text-3xl md:text-5xl font-semibold text-slate-900 dark:text-white mb-4 tracking-tight leading-tight">
          {t("genui.headingLead")} <span class="text-indigo-600 dark:text-indigo-400">{t("genui.headingAccent")}</span>
        </h2>

        <p class="text-lg text-slate-600 dark:text-slate-400 mb-8 max-w-xl leading-relaxed">
          {t("genui.descMain")} <a href="https://www.nimblersoft.com/" target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline decoration-indigo-500/30">Nimblersoft</a>{t("genui.descSuffix")}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href={waLink}
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm rounded-lg transition-all duration-200 transform hover:-translate-y-0.5"
          >
            {t("genui.ctaStart")}
            <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          
          <a
            href="https://www.nimblersoft.com/"
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg transition-colors"
          >
            {t("genui.ctaExplore")}
          </a>
        </div>
      </div>

      <!-- Visual Side (Abstract GenUI representation) -->
      <div class="relative w-full max-w-[320px] aspect-square flex items-center justify-center">
        <div class="absolute inset-0 bg-indigo-500/5 dark:bg-indigo-500/10 rounded-2xl rotate-6 scale-95"></div>
        <div class="absolute inset-0 bg-slate-500/5 dark:bg-slate-500/10 rounded-2xl -rotate-3 scale-95"></div>
        <div class="relative w-full h-full bg-slate-50/80 dark:bg-slate-800/80 backdrop-blur-xl rounded-lg border border-slate-200 dark:border-slate-700 p-6 flex flex-col justify-between shadow-sm overflow-hidden">
          <!-- Mock UI Elements -->
          <div class="space-y-3">
            <div class="h-2 w-1/3 bg-slate-200 dark:bg-slate-700 rounded-full animate-pulse"></div>
            <div class="h-8 w-full bg-slate-200/50 dark:bg-slate-700/50 rounded-lg"></div>
            <div class="h-4 w-2/3 bg-slate-200/30 dark:bg-slate-700/30 rounded-full"></div>
          </div>
          
          <div class="flex gap-2">
            <div class="h-10 w-10 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg border border-indigo-500/20 dark:border-indigo-500/30 flex items-center justify-center text-indigo-600 dark:text-indigo-400">
               <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div class="flex-1 h-10 bg-slate-200/20 dark:bg-slate-700/20 rounded-lg border border-slate-200/30 dark:border-slate-700/30"></div>
          </div>
          
          <div class="space-y-2">
             <div class="h-2 w-full bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
             <div class="h-2 w-4/5 bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
             <div class="h-2 w-1/2 bg-slate-200/20 dark:bg-slate-700/20 rounded-full"></div>
          </div>

          <!-- Glow -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-indigo-500/10 dark:bg-indigo-500/20 blur-2xl rounded-full"></div>
        </div>
      </div>
    </div>
  </div>
</section>
