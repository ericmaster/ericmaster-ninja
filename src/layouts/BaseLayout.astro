---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AiChatbot from "../components/AiChatbot.astro";
import { getTranslationPair, type Locale } from "../i18n/routePairs";
import "@fontsource/poppins/index.css";
import "../styles/global.css";

interface Props {
  pageTitle?: string;
  skipLinkTarget?: string;
  skipLinkLabel?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  locale?: Locale;
  ogType?: string;
  /** Pass true from layouts that build their own <h1> */
  showPageTitle?: boolean;
  /** Visible <h1> text when it should differ from the SEO/tab title (e.g. a homepage slogan) */
  heading?: string;
  /** Center the page-title band (used on the homepage hero) */
  centerTitle?: boolean;
  frontmatter?: { title?: string; description?: string };
}

const {
  pageTitle,
  skipLinkTarget,
  skipLinkLabel = "Skip to content",
  description,
  ogImage,
  robots,
  locale,
  ogType,
  showPageTitle = true,
  heading,
  centerTitle = false,
  frontmatter,
} = Astro.props;

const title = pageTitle ?? frontmatter?.title ?? "Home";
const pageHeading = heading ?? title;
const metaDescription = description ?? frontmatter?.description;

const currentLocale: Locale = locale === "es" || locale === "en" ? locale : Astro.currentLocale === "es" ? "es" : "en";
const translationPair = getTranslationPair(Astro.url.pathname);
---

<html lang={currentLocale}>
  <head>
    <Head title={title} description={metaDescription} ogImage={ogImage} locale={currentLocale} robots={robots} ogType={ogType} />
    {translationPair && <>
      <link rel="alternate" hreflang="en" href={new URL(translationPair.en, Astro.site || Astro.url.origin)} />
      <link rel="alternate" hreflang="es" href={new URL(translationPair.es, Astro.site || Astro.url.origin)} />
      <link rel="alternate" hreflang="x-default" href={new URL(translationPair.en, Astro.site || Astro.url.origin)} />
    </>}
  </head>
  <body>
    <canvas
      id="constellation-bg"
      class="fixed top-0 left-0 w-screen h-screen -z-10"></canvas>
    {skipLinkTarget && <a href={`#${skipLinkTarget}`} class="sr-only focus:not-sr-only focus:relative focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center">{skipLinkLabel}</a>}
    <Header locale={currentLocale} />
    {showPageTitle && <h1 class:list={["page-title", { "text-center": centerTitle }]}>{pageHeading}</h1>}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <slot />
    </div>
    <Footer locale={currentLocale} />
    <script src="/assets/constellation.js" is:inline></script>
    <!-- Alpine.js CSP build — self-hosted via npm, no unsafe-eval required (ADR-0001) -->
    <script>
      // @ts-ignore — @alpinejs/csp ships no type declarations
      import Alpine from "@alpinejs/csp";
      import { nimblerbotChat } from "../lib/nimblerbotChat";

      Alpine.data("nimblerbotChat", nimblerbotChat);

      /** Mobile nav toggle — used by Header.astro */
      Alpine.data("mobileNav", () => ({
        navOpen: false,
        toggleNav() {
          this.navOpen = !this.navOpen;
        },
        get ariaExpanded() {
          return String(this.navOpen);
        },
        get navClass() {
          return { block: this.navOpen, hidden: !this.navOpen };
        },
      }));

      /** Language switcher dropdown — used by LanguageSwitcher.astro */
      Alpine.data("languageSwitcher", () => ({
        open: false,
        toggle() {
          this.open = !this.open;
        },
        close() {
          this.open = false;
        },
        menuItems(): HTMLElement[] {
          const menu = (this as any).$refs?.menu as HTMLElement | undefined;
          return menu ? Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]')) : [];
        },
        focusItem(index: number) {
          const items = this.menuItems();
          if (!items.length) return;
          const target = items[(index + items.length) % items.length];
          target?.focus();
        },
        onKeydown(event: KeyboardEvent) {
          const trigger = (this as any).$refs?.trigger as HTMLElement | undefined;
          if (event.key === "Escape" && this.open) {
            event.preventDefault();
            this.close();
            trigger?.focus();
            return;
          }
          if (event.key === "Tab" && this.open) {
            this.close();
            return;
          }
          if (document.activeElement === trigger && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
            event.preventDefault();
            this.open = true;
            (this as any).$nextTick(() => this.focusItem(event.key === "ArrowUp" ? -1 : 0));
            return;
          }
          if (!this.open) return;
          const items = this.menuItems();
          const currentIndex = items.indexOf(document.activeElement as HTMLElement);
          if (currentIndex === -1) return;
          if (event.key === "ArrowDown") {
            event.preventDefault();
            this.focusItem(currentIndex + 1);
          } else if (event.key === "ArrowUp") {
            event.preventDefault();
            this.focusItem(currentIndex - 1);
          } else if (event.key === "Home") {
            event.preventDefault();
            this.focusItem(0);
          } else if (event.key === "End") {
            event.preventDefault();
            this.focusItem(-1);
          }
        },
        get ariaExpanded() {
          return String(this.open);
        },
        get chevronClass() {
          return { "rotate-180": this.open };
        },
      }));

      /** Scroll-spy sidebar nav — used by ResumeNav.astro */
      Alpine.data("resumeNav", () => ({
        active: "",
        navItemClass() {
          // CSP-safe: read context from data attribute; this.$el is the bound element
          return (this as any).$el?.dataset?.sectionId === this.active
            ? "active"
            : "";
        },
        scrollToSection(event: MouseEvent) {
          const id = (event.currentTarget as HTMLElement).dataset.sectionId;
          if (id)
            document
              .getElementById(id)
              ?.scrollIntoView({ behavior: "smooth", block: "start" });
        },
        init() {
          const ids = [
            "summary-heading",
            "experience-heading",
            "skills-heading",
            "projects-heading",
            "education-heading",
            "certifications-heading",
            "languages-heading",
            "leadership-heading",
          ];
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) this.active = entry.target.id;
              });
            },
            { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
          );
          ids.forEach((id) => {
            const el = document.getElementById(id);
            if (el) observer.observe(el);
          });
        },
      }));

      /** Floating sticky category nav — used by ResourcesNav.astro */
      Alpine.data("resourcesNav", () => ({
        active: "projects",
        scrollToSection(event: MouseEvent) {
          const id = (event.currentTarget as HTMLElement).dataset.sectionId;
          if (id) {
            const el = document.getElementById(id);
            if (el) {
              const yOffset = -140;
              const y = el.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: "smooth" });
              this.active = id;
            }
          }
        },
        init() {
          const ids = ["projects", "cheatsheets"];
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  this.active = entry.target.id;
                }
              });
            },
            { rootMargin: "-120px 0px -60% 0px", threshold: 0 }
          );
          ids.forEach((id) => {
            const el = document.getElementById(id);
            if (el) observer.observe(el);
          });
        },
      }));

      // Defer start to allow page-specific scripts to register components
      setTimeout(() => {
        Alpine.start();
      }, 0);
    </script>
    <AiChatbot />
  </body>
</html>
