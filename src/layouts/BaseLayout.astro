---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AiChatbot from "../components/AiChatbot.astro";
import "@fontsource/poppins";
import "../styles/global.css";

interface Props {
  pageTitle?: string;
  description?: string;
  ogImage?: string;
  /** Pass true from layouts that build their own <h1> */
  showPageTitle?: boolean;
  frontmatter?: { title?: string; description?: string };
}

const {
  pageTitle,
  description,
  ogImage,
  showPageTitle = true,
  frontmatter,
} = Astro.props;

const title = pageTitle ?? frontmatter?.title ?? "Home";
const metaDescription = description ?? frontmatter?.description;
---

<html lang="en">
  <head>
    <Head title={title} description={metaDescription} ogImage={ogImage} />
  </head>
  <body>
    <canvas
      id="constellation-bg"
      class="fixed top-0 left-0 w-screen h-screen -z-10"></canvas>
    <Header />
    {showPageTitle && <h1 class="page-title">{title}</h1>}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <slot />
    </div>
    <Footer />
    <script src="/assets/constellation.js" is:inline></script>
    <!-- Alpine.js CSP build — self-hosted via npm, no unsafe-eval required (ADR-0001) -->
    <script>
      // @ts-ignore — @alpinejs/csp ships no type declarations
      import Alpine from "@alpinejs/csp";

      /** Mobile nav toggle — used by Header.astro */
      Alpine.data("mobileNav", () => ({
        navOpen: false,
        toggleNav() {
          this.navOpen = !this.navOpen;
        },
        get ariaExpanded() {
          return String(this.navOpen);
        },
        get navClass() {
          return { block: this.navOpen, hidden: !this.navOpen };
        },
      }));

      /** Scroll-spy sidebar nav — used by ResumeNav.astro */
      Alpine.data("resumeNav", () => ({
        active: "",
        navItemClass() {
          // CSP-safe: read context from data attribute; this.$el is the bound element
          return (this as any).$el?.dataset?.sectionId === this.active
            ? "active"
            : "";
        },
        scrollToSection(event: MouseEvent) {
          const id = (event.currentTarget as HTMLElement).dataset.sectionId;
          if (id)
            document
              .getElementById(id)
              ?.scrollIntoView({ behavior: "smooth", block: "start" });
        },
        init() {
          const ids = [
            "summary-heading",
            "experience-heading",
            "skills-heading",
            "projects-heading",
            "education-heading",
            "certifications-heading",
            "languages-heading",
            "leadership-heading",
          ];
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) this.active = entry.target.id;
              });
            },
            { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
          );
          ids.forEach((id) => {
            const el = document.getElementById(id);
            if (el) observer.observe(el);
          });
        },
      }));

      Alpine.start();
    </script>
    <AiChatbot />
  </body>
</html>
