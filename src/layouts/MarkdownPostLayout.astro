---
import BaseLayout from "./BaseLayout.astro";
import { formatLocalizedDate } from "../lib/dateUtils";
import { getLangFromUrl, getLocalePath } from "../i18n/utils";
import { Image } from "astro:assets";
const { frontmatter } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dateLocale = lang === "es" ? "es-ES" : "en-US";
---

<BaseLayout pageTitle={frontmatter.title}>
  <div class="max-w-4xl mx-auto">
    <p class="text-right">{formatLocalizedDate(frontmatter.pubDate, dateLocale)}</p>
    <p class="text-xl mb-8"><em>{frontmatter.description}</em></p>
  </div>

  <div class="w-full aspect-[16/9] mb-8 lg:-mx-0">
    <Image
      src={frontmatter.image.url.startsWith("/")
        ? frontmatter.image.url
        : `/${frontmatter.image.url}`}
      alt={frontmatter.image.alt}
      width={1200}
      height={675}
      class="w-full h-full object-cover object-top rounded-xl shadow-2xl"
      loading="lazy"
    />
  </div>

  <div class="max-w-4xl mx-auto post-content">
    <div class="tags mb-8">
      {
        frontmatter.tags.map((tag: string) => (
          <p class="tag">
            <a href={getLocalePath(lang, `/tags/${tag}`)}>{tag}</a>
          </p>
        ))
      }
    </div>

    <article class="prose prose-lg dark:prose-invert max-w-none">
      <slot />
    </article>
  </div>

  <script>
    import mermaid from "mermaid";

    async function renderMermaid() {
      const isDark = document.documentElement.classList.contains("dark");
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? "dark" : "default",
        fontFamily: "Poppins, sans-serif",
        securityLevel: "loose",
        themeVariables: isDark
          ? {
              darkMode: true,
              background: "#0f172a",
              primaryColor: "#3b82f6",
              primaryTextColor: "#f8fafc",
              primaryBorderColor: "#60a5fa",
              lineColor: "#94a3b8",
              secondaryColor: "#1e293b",
              tertiaryColor: "#0f172a",
            }
          : {
              darkMode: false,
              background: "#ffffff",
              primaryColor: "#4f46e5",
              primaryTextColor: "#0f172a",
              primaryBorderColor: "#6366f1",
              lineColor: "#64748b",
              secondaryColor: "#f1f5f9",
              tertiaryColor: "#ffffff",
            },
      });

      const elements = document.querySelectorAll("pre code.language-mermaid, pre.mermaid, code.language-mermaid");
      if (!elements.length) return;

      for (let i = 0; i < elements.length; i++) {
        const el = elements[i];
        const code = el.textContent?.trim() || "";
        if (!code) continue;

        const pre = el.closest("pre") || el;
        const container = document.createElement("div");
        container.className = "mermaid-container my-8 flex justify-center overflow-x-auto p-4 rounded-xl bg-slate-50/70 dark:bg-slate-900/70 border border-slate-200/80 dark:border-slate-800 shadow-sm";
        const id = `mermaid-svg-${i}-${Date.now()}`;

        try {
          const { svg } = await mermaid.render(id, code);
          container.innerHTML = svg;
          pre.replaceWith(container);
        } catch (e) {
          console.error("Mermaid diagram rendering error:", e);
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        renderMermaid();
      });
    } else {
      renderMermaid();
    }
  </script>
</BaseLayout>
