---
import BaseLayout from "./BaseLayout.astro";
import { getPosts } from "../lib/blogUtils";
const linkedTags = new Set((await getPosts(undefined, "en")).flatMap(post => post.data.tags || []));
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <div class="max-w-4xl mx-auto post-content py-8">
    {frontmatter.tags && (
      <div class="tags mb-8">
        {frontmatter.tags.map((tag: string) => (
          <p class="tag">
            {linkedTags.has(tag) ? <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a> : <span>{tag}</span>}
          </p>
        ))}
      </div>
    )}

    <article>
      <slot />
    </article>
  </div>
</BaseLayout>
