---
import BaseLayout from "../layouts/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { Content } from "./content/pages/home-content.md";
const pageTitle = "AI engineering & writing";
---

<BaseLayout pageTitle={pageTitle} showPageTitle={false} skipLinkTarget="home-main" skipLinkLabel="Skip to content" description="AI products, agentic development and engineering mentorship. Eric Aguayo, Quito, Ecuador.">
  <main id="home-main" tabindex="-1" class="pb-10">
    <section aria-labelledby="home-heading" class="grid gap-7 border-b border-slate-200 py-8 sm:py-12 lg:grid-cols-[1fr_240px] lg:items-center dark:border-slate-800">
      <div class="min-w-0">
        <p class="mb-2 text-sm font-semibold tracking-wide text-indigo-700 dark:text-indigo-300">Senior AI & full-stack engineer</p>
        <h1 id="home-heading" class="my-2 text-4xl font-semibold tracking-tight sm:text-5xl">Eric Aguayo<span class="mt-3 block text-2xl font-normal leading-snug text-slate-600 sm:text-3xl dark:text-slate-300">Code with Intent. Build to Endure.</span>
        </h1>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/work" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-indigo-700 px-5 py-3 text-base font-semibold !text-white hover:bg-indigo-800">How to work with me</a>
          <a href="/blog" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 px-5 py-3 text-base font-medium text-slate-800 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800">Read my writing</a>
        </div>
      </div>
      <figure class="m-0 flex items-center gap-4 lg:block">
        <img src="/assets/eric-anime-run.jpg" alt="Illustration of Eric trail running" width="320" height="320" class="h-24 w-24 flex-none rounded-2xl object-cover sm:h-32 sm:w-32 lg:h-60 lg:w-60" />
        <figcaption class="text-sm text-slate-600 lg:mt-3 dark:text-slate-400">Quito, Ecuador.<br />Engineer. Builder. Trail runner.</figcaption>
      </figure>
    </section>
    <section class="home-intro max-w-3xl py-6 sm:py-8"><Content /></section>
    <LatestPosts class="w-full max-w-4xl border-t border-slate-200 pt-6 dark:border-slate-800" />
  </main>
</BaseLayout>
