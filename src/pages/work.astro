---
import BaseLayout from "../layouts/BaseLayout.astro";
import GenUiHighlight from "../components/GenUiHighlight.astro";
import ExpertAiSolutions from "../components/ExpertAiSolutions.astro";
const work = await import("./content/pages/work-content.md");
const { Content, frontmatter } = work;
const pageTitle = frontmatter.title;
---

<BaseLayout pageTitle={pageTitle} description="Portfolio of Eric Aguayo's coding projects, AI bots, and professional work.">
  <GenUiHighlight />
  <Content />
  <ExpertAiSolutions />
</BaseLayout>