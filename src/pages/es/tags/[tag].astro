---
// src/pages/es/tags/[tag].astro

import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostTeaser from '../../../components/PostTeaser.astro';
import { getPosts } from '../../../lib/blogUtils';

export async function getStaticPaths() {
  const posts = await getPosts(undefined, 'es');

  // Flatten all tags across posts
  const tagSet = new Set();
  for (const post of posts) {
    if (post.data.tags) {
      post.data.tags.forEach(tag => tagSet.add(tag));
    }
  }

  return Array.from(tagSet).map(tag => ({
    params: { tag }
  }));
}

const { tag } = Astro.params as { tag: string };
const allPosts = await getPosts(undefined, 'es');
const filteredPosts = allPosts.filter(post =>
  post.data.tags?.includes(tag)
);
---


<BaseLayout pageTitle={`Entradas etiquetadas con ${tag}`}>
  <ul>
  {filteredPosts.map(post => (
    <li><PostTeaser post={post} /></li>
  ))}
</ul>
</BaseLayout>
