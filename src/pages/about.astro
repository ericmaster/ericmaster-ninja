---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkedInBadge from "../components/LinkedInBadge.astro";
const about = await import("./content/pages/about-content.md");
const { Content, frontmatter } = about;
const pageTitle = frontmatter.title;
---

<BaseLayout pageTitle={pageTitle}>
  <div class="block">
    <div class="float-none sm:float-left mb-6 sm:mb-2 sm:mr-8 flex flex-col items-center sm:items-center gap-6 w-full sm:w-auto sm:max-w-xs">
      <img
        src="/assets/images/about.jpg"
        alt="Eric Aguayo"
        class="w-full max-w-xs h-auto rounded-xl shadow-lg"
      />
      <LinkedInBadge class="flex justify-center w-full" />
    </div>
    <div>
      <Content />
    </div>
  </div>
</BaseLayout>